# ─────────────────────────────────────────────────────────────────────────────
# PhotoBot — example configuration
# Copy this file to .env and fill in your values before starting the bot.
#
#   cp .env.example .env
#
# Lines starting with # are comments and are ignored.
# Avoid # characters inside values — they start an inline comment and will
# silently truncate the value. Use letters, numbers, and hyphens in secrets.
# ─────────────────────────────────────────────────────────────────────────────


# ── Bluesky ───────────────────────────────────────────────────────────────────

# The handle of your bot account, e.g. photobot.bsky.social
BLUESKY_HANDLE=yourbot.bsky.social

# App password for the bot account.
# Generate one at: bsky.social → Settings → App Passwords
# Never use your real account password here.
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx


# ── Chevereto ─────────────────────────────────────────────────────────────────

# Base URL of your Chevereto instance — no trailing slash.
# The bot scrapes the public /explore/recent page; no API key is required.
CHEVERETO_BASE_URL=https://photos.yourteam.com


# ── Posting behaviour ─────────────────────────────────────────────────────────

# Number of photos to include in each hourly gallery post (1–4).
# Bluesky supports up to 4 images per post.
POSTS_PER_HOUR=4

# Recency bias exponent for weighted image selection.
# Higher values favour newer uploads more strongly.
#   1.0 = uniform random across the whole pool
#   1.5 = moderate recency bias (default)
#   3.0 = strong recency bias — oldest images rarely appear
RECENCY_BIAS=1.5


# ── Web dashboard ─────────────────────────────────────────────────────────────

# Port the dashboard is served on inside the container.
# The docker-compose.yml maps this to the same port on the host.
DASHBOARD_PORT=3000

# Named volume for new installations. Existing deployments without this
# setting keep using /media/Sea1/AppData/photobot.
PHOTOBOT_DATA_DIR=photobot-data

# Shared secret for dashboard access.
# Any visitor who knows this string can control the bot.
# Use a long random string — a password manager can generate one.
# Example (do not use this exact value): rJv9mKx4-Wnq2-Pt8Z-Lc6Y-Ds3Nh7Bf1Ue
DASHBOARD_SECRET=

# Secret used to sign session cookies.
# Use a different value from DASHBOARD_SECRET. A fixed value shared by both
# services is required for high-resolution Buffer renders.
SESSION_SECRET=

# Set to true when the dashboard is behind a reverse proxy (nginx, Caddy, etc.).
# Required for:
#   - Secure (HTTPS-only) session cookies to work correctly
#   - The rate limiter to see real client IPs instead of the proxy's address
#   - OIDC login to work at all when the redirect URI is https://
# Leave unset or set to false for local-only access.
TRUST_PROXY=false


# ── DM commands ───────────────────────────────────────────────────────────────

# Comma-separated list of Bluesky handles that are allowed to send bot commands
# via direct message. Include the handle without the leading @.
# Example: alice.bsky.social,bob.bsky.social
ADMIN_HANDLES=yourhandle.bsky.social


# ── Buffer crossposting (optional) ───────────────────────────────────────────
#
# Posts to Buffer automatically after every Bluesky post, so your content
# reaches X, Instagram, LinkedIn, and any other platform you have connected.
#
# Setup:
#   1. Go to https://publish.buffer.com/settings/api
#   2. Generate a personal API token
#   3. Paste it into the dashboard → Buffer Crossposting section
#   4. Select which channels to post to, save, and enable
#
# The token is saved in bot-state.json (not here) after you paste it in the
# dashboard. You do not need to put it in this file.
#
# ⚠️  Buffer tokens expire 30 days after creation. The dashboard shows a
#     warning when your token is close to expiry. Regenerate at the same URL
#     and re-save in the dashboard when prompted.
#
# ── OIDC / SSO login (optional) ───────────────────────────────────────────────
#
# Allows team members to sign in to the dashboard with Google, Authentik,
# Keycloak, or any OpenID Connect provider instead of the shared secret.
# The shared secret continues to work alongside OIDC — both are always accepted.
#
# Leave all OIDC_* variables commented out to disable SSO entirely.

# Discovery URL of your identity provider.
# The bot fetches /.well-known/openid-configuration from this URL at startup.
#
#   Google:     https://accounts.google.com
#   Authentik:  https://auth.yourdomain.com/application/o/your-app-slug/
#   Keycloak:   https://keycloak.yourdomain.com/realms/your-realm
#
#OIDC_ISSUER_URL=https://accounts.google.com

# OAuth2 client credentials — obtained from your identity provider's admin UI.
#OIDC_CLIENT_ID=your-client-id
#OIDC_CLIENT_SECRET=your-client-secret

# Redirect URI — must exactly match what you registered with your IdP.
# Always ends with /auth/callback on your public dashboard URL.
#OIDC_REDIRECT_URI=https://photobot.yourdomain.com/auth/callback

# Optional email allow-list. Only the listed addresses (or domains) can log in,
# even if they successfully authenticate with the IdP.
#
# Formats supported:
#   Exact email:   alice@example.com
#   Whole domain:  @yourteam.com   (matches any address at that domain)
#   Mixed:         alice@gmail.com,@yourteam.com
#
# Leave commented out to allow any user your IdP authenticates.
#OIDC_ALLOWED_EMAILS=@yourteam.com
